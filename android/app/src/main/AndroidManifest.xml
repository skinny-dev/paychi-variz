<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Not required: a phone-less tablet can still listen to bank-app notifications. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- usesCleartextTraffic is on so a LAN / http dev server works. Use https in production. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Paychi"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Quick connect link from the dashboard's /connect page: paychi://pair?u=<server>&c=<code> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="paychi" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- QR scanner screen, usable in portrait. The camera is only used here. -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme" />

        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".NotifListener"
            android:exported="true"
            android:label="Paychi Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!-- Android 13+: the system does not even deliver ongoing notifications or chats to us. -->
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="alerting|silent" />
        </service>

        <!-- Retries failed deliveries only when the network is up (see FlushJob). -->
        <service
            android:name=".FlushJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
