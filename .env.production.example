# Production settings. On Runflare enter these as environment variables in the app's panel;
# on a VPS copy this file to .env.production and run `docker compose up -d`.

NODE_ENV=production
# Port the server listens on inside the container. Runflare / the proxy forwards to it.
PORT=3000
HOST=0.0.0.0
# Public HTTPS address (Runflare subdomain or your own domain). No trailing slash.
# Used in payment links, the quick-connect QR and secure cookies.
BASE_URL=https://variz.example.ir
# Must be on the persistent disk mounted at /app/data.
DB_PATH=/app/data/paychi.db
LOG_LEVEL=warn

# "off" = internal use: no subscription needed, no plan limits (plans and pricing come later).
BILLING_MODE=off
# Invite code required to sign up. Set one so strangers cannot create accounts on your server.
SIGNUP_CODE=change-me

# Where the dashboard's "download app" button points when the APK is not inside the image
# (e.g. a GitHub release asset). Leave empty if public/downloads/paychi-listener.apk is deployed.
APK_URL=

# Telegram payment alerts (optional). Create a bot with @BotFather and paste its token.
# If this server cannot reach api.telegram.org, point TELEGRAM_API_BASE at a relay / proxy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org

# Business rules (same meaning as in .env.example).
DEFAULT_CARD_LIMIT=100000000
TX_TTL_SEC=600
TX_MIN_TTL_SEC=60
TX_MAX_TTL_SEC=3600
MAX_AMOUNT_DELTA=500
GRACE_SEC=60
AMOUNT_COOLDOWN_SEC=1800

# Webhooks to localhost / private IPs are blocked in production. Set to 1 only if your
# webhook receiver is another service on the same private network (e.g. the "paychi" network).
ALLOW_PRIVATE_WEBHOOKS=0
