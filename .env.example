# Copy to .env and adjust.
PORT=3000
# Public URL of this server (used in payment links). Use https in production.
BASE_URL=http://localhost:3000
DB_PATH=./data/paychi.db

# "mock" activates a plan instantly without charging (development only).
BILLING_MODE=mock

# Default daily card-to-card ceiling per card, in Rial (100,000,000 Rial = 10M Toman).
DEFAULT_CARD_LIMIT=100000000

# Transaction lifetime (seconds): default / min / max.
TX_TTL_SEC=600
TX_MIN_TTL_SEC=60
TX_MAX_TTL_SEC=3600

# How many Rials may be added to the requested amount to make it unique.
MAX_AMOUNT_DELTA=500
# A late SMS still counts for this many seconds after expiry.
GRACE_SEC=60
# An amount is not reused for this long after its transaction ended.
AMOUNT_COOLDOWN_SEC=1800

# Set to 1 to allow webhooks to localhost / private IPs (always allowed outside NODE_ENV=production).
ALLOW_PRIVATE_WEBHOOKS=0
